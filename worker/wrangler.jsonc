{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transcription",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "transcription.ytyz.ca", "custom_domain": true }
  ],
  "assets": {
    "directory": "../frontend/app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/api/*", "/s3/*", "/__usage"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transcription",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "transcription" }
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "JWT_EXP_SECONDS": "604800",
    "MAX_UPLOAD_MB": "2048",
    "STALE_JOB_SECONDS": "600",
    "MAX_JOB_ATTEMPTS": "3"
  },
  "observability": { "enabled": true }
}
